{
  "name": "@tra-bilisim/tra-ui",
  "version": "0.0.21",
  "description": "TRA UI Base CLI - Plugin installer for tra-ui-base projects",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tra-ui": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "execa": "^9.6.0",
    "fs-extra": "^11.3.0",
    "inquirer": "^9.3.8",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0"
  },
  "keywords": [
    "tra",
    "ui-base",
    "cli",
    "react",
    "typescript",
    "tailwind",
    "plugins"
  ],
  "author": "TRA Bilişim",
  "license": "MIT"
}