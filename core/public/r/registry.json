        {
          "path": "registry/tra-plugins/signalr/hooks/useMessageHub.ts",
          "type": "registry:file",
          "target": "src/hooks/useMessageHub.ts"
        }
      ]
    },
    {
      "name": "plugin-table",
      "type": "registry:block",
      "title": "Data Table (TanStack Table)",
      "description": "TanStack Table tabanlı veri tablosu. Sıralama, filtreleme, sayfalama, skeleton ve filtre section bileşenleri.",
      "dependencies": ["@tanstack/react-table", "@tanstack/match-sorter-utils"],
      "registryDependencies": [
        "@tra-kit/skeleton",
        "@tra-kit/input",
        "@tra-kit/select",
        "@tra-kit/pagination"
      ],
      "files": [
