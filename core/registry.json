    {
      "name": "plugin-signalr",
      "type": "registry:block",
      "title": "Real-time (SignalR)",
      "description": "SignalR HubConnection yönetimi, otomatik reconnect, MessageHubContext, useSignalR ve useMessageHub hook'ları.",
